{
  "name": "study-with-huster",
  "version": "0.3.0",
  "private": true,
  "description": "Phòng học trực tuyến trong Thư viện Tạ Quang Bửu 3D",
  "scripts": {
    "dev": "node tools/fake-supabase-server.mjs --port=3000 --csp",
    "start": "node tools/fake-supabase-server.mjs --port=3000 --offline --csp",
    "check": "node tools/check-source.mjs",
    "test": "node tools/kiem_tra_dieu_khien.mjs && node tools/kiem_tra_ghe.mjs && node tools/kiem_tra_tuong_tac.mjs && node tools/test-network.mjs && node --test tools/*.test.mjs",
    "test:multiplayer": "node tools/kiem_tra_nhieu_nguoi.mjs",
    "test:lift": "node tools/kiem_tra_thang_may.mjs",
    "test:render": "node tools/kiem_tra_ghe_render.mjs --port=3101",
    "test:ui": "node tools/kiem_tra_giao_dien_render.mjs --port=3102",
    "test:mobile": "node tools/kiem_tra_mobile.mjs",
    "test:motion": "node tools/kiem_tra_chuyen_dong.mjs"
  }
}
